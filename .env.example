# ─── CircuitBreaker-AI — Environment Template ────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored; this file is safe to commit.

# JEV AI — Calibrated Decision API
JEV_API_KEY=your_jev_api_key_here
JEV_ENDPOINT=https://api.typesafe.ai/v1/decide

# Upstream RPC (Alchemy, Infura, QuickNode, or local node)
UPSTREAM_RPC=https://eth.llamarpc.com

# Proxy server
PORT=8545
POLICY_MODE=strict           # strict | permissive | audit

# Analysis timeout in ms — keep ≤ 1000 to avoid UX stall
ANALYSIS_TIMEOUT_MS=800

# Maximum concurrent analysis pipelines before requests are queued
MAX_CONCURRENT_ANALYSES=50
